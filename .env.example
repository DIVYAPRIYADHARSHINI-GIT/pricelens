# PriceLens environment variables.
# Copy to .env (local) or add in Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real keys. With nothing set, PriceLens runs in DEMO MODE (MockProvider,
# built-in sample data, "Demo mode" badge) - no keys needed.

# --- Switch to the RealProvider -------------------------------------------------
# Set to "real" to try live data. The RealProvider is only used when this is "real"
# AND SERPAPI_API_KEY is present; otherwise the app stays in demo mode.
PRICELENS_PROVIDER=mock

# Prices / store listings: SerpAPI Google Shopping (https://serpapi.com/google-shopping-api)
SERPAPI_API_KEY=

# Image detection (optional): Google Cloud Vision API key with the Vision API enabled.
# Uses WEB_DETECTION (best-guess label + web entities) and LABEL_DETECTION.
# Without it, photos are detected with the demo dominant-colour matcher and the
# detected category name is searched live.
GOOGLE_VISION_API_KEY=

# Google Shopping country / language for live results (default: in / en)
PRICELENS_COUNTRY=in
PRICELENS_LANGUAGE=en

# --- Limits -------------------------------------------------------------------------
# Requests per minute per IP on /api/search and /api/prices (default 60, in-memory per instance)
RATE_LIMIT_PER_MIN=60
